# Use the official Rust nightly image as a base
FROM rustlang/rust:nightly AS builder

# Set the working directory
WORKDIR /app

# Copy the Cargo manifests first for better build caching
COPY Cargo.toml Cargo.lock ./
COPY api-gateway/Cargo.toml api-gateway/Cargo.toml
COPY common/Cargo.toml common/Cargo.toml
COPY blockchain-server/Cargo.toml blockchain-server/Cargo.toml
COPY crypto-lib/Cargo.toml crypto-lib/Cargo.toml

# Copy the full source (after manifests to maximize cache hits)
COPY . .

# Build the application in release mode (only the api-gateway package)
WORKDIR /app
RUN cargo build --release -p api-gateway

# Use a minimal base image for the final stage
FROM debian:bookworm-slim AS runtime

# Set the working directory
WORKDIR /app

# Install runtime dependencies (certs and OpenSSL for TLS)
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates openssl curl \
	&& update-ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# Copy the compiled binaries from the builder stage
COPY --from=builder /app/target/release/api-gateway /app/api-gateway
COPY --from=builder /app/target/release/api-gateway-persistent /app/api-gateway-persistent

# Expose the port the application runs on
EXPOSE 8081

# Default command
CMD ["/app/api-gateway"]