# Dockerfile spécialisé pour compilation Rust blockchain server
# Utilise multi-stage build pour optimiser la taille et la compilation

# === STAGE 1: Construction Rust ===
FROM rust:1.80-slim-bullseye as rust-builder

# Installation des dépendances système nécessaires
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de configuration Cargo pour optimiser le cache
COPY Cargo.toml ./
COPY blockchain-server/Cargo.toml ./blockchain-server/
COPY api-gateway/Cargo.toml ./api-gateway/
COPY common/Cargo.toml ./common/
COPY crypto-lib/Cargo.toml ./crypto-lib/
COPY tests/Cargo.toml ./tests/

# Créer des fichiers source temporaires pour permettre le cache des dépendances
RUN mkdir -p blockchain-server/src api-gateway/src common/src crypto-lib/src tests/src && \
    echo "fn main() {}" > blockchain-server/src/main.rs && \
    echo "pub fn dummy() {}" > blockchain-server/src/lib.rs && \
    echo "fn main() {}" > api-gateway/src/main.rs && \
    echo "pub fn dummy() {}" > api-gateway/src/lib.rs && \
    echo "pub fn dummy() {}" > common/src/lib.rs && \
    echo "pub fn dummy() {}" > crypto-lib/src/lib.rs && \
    echo "pub fn dummy() {}" > tests/src/lib.rs

# Compiler les dépendances (cette étape sera mise en cache)
RUN cargo build --package blockchain-server --release

# Copier le code source réel
COPY blockchain-server/src ./blockchain-server/src/
COPY api-gateway/src ./api-gateway/src/
COPY common/src ./common/src/
COPY crypto-lib/src ./crypto-lib/src/
COPY tests/src ./tests/src/
COPY tests/integration_tests.rs ./tests/

# Nettoyer les binaires temporaires et recompiler avec le vrai code
RUN rm -rf target/release/deps/blockchain*  && \
    rm -rf target/release/blockchain-server* && \
    cargo build --package blockchain-server --release

# === STAGE 2: Runtime optimisé ===
FROM debian:bullseye-slim as runtime

# Installation des dépendances runtime uniquement
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl1.1 \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

# Créer un utilisateur non-root pour la sécurité
RUN useradd --create-home --shell /bin/bash --user-group --uid 1001 rustapp

# Définir le répertoire de travail
WORKDIR /app

# Copier l'exécutable depuis le stage de construction
COPY --from=rust-builder /app/target/release/blockchain-server /app/blockchain-server

# Créer le répertoire pour la base de données
RUN mkdir -p /app/data && chown -R rustapp:rustapp /app

# Changer vers l'utilisateur non-root
USER rustapp

# Exposer le port de l'application
EXPOSE 8080

# Définir les variables d'environnement
ENV RUST_LOG=info
ENV DATABASE_URL=sqlite:/app/data/blockchain.db
ENV PORT=8080

# Commande de démarrage
CMD ["./blockchain-server"]