# Dockerfile simplifié pour l'interface web uniquement
FROM node:18-alpine as builder

# Installer les dépendances pour servir des fichiers statiques
RUN npm install -g http-server

# Créer le répertoire de travail
WORKDIR /app

# Copier les fichiers HTML et CSS
COPY index.html ./
COPY src/styles ./src/styles

# Créer un serveur simple
FROM nginx:alpine

# Copier les fichiers
COPY demo.html /usr/share/nginx/html/index.html
COPY src/styles /usr/share/nginx/html/src/styles

# Configuration nginx pour SPA
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://host.docker.internal:8080; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]