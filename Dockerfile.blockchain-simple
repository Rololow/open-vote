# Dockerfile simple pour blockchain server uniquement
FROM rustlang/rust:nightly-slim AS builder

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Créer utilisateur et workspace
RUN useradd -m -u 1000 rustuser
RUN mkdir -p /app && chown rustuser:rustuser /app
WORKDIR /app
USER rustuser

# Créer un Cargo.toml simple pour blockchain seulement
COPY --chown=rustuser:rustuser <<EOF Cargo.toml
[workspace]
members = [
    "crypto-lib",
    "common", 
    "blockchain-server",
    "api-gateway",
    "tests"
]

[workspace.package]
version = "0.1.0"
edition = "2021"

[workspace.dependencies]
tokio = { version = "1.0", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
uuid = { version = "1.0", features = ["v4"] }
anyhow = "1.0"
thiserror = "1.0"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
axum = "0.7"
tower = "0.4"
tower-http = { version = "0.5", features = ["cors", "trace"] }
tokio-postgres = "0.7"
sqlx = { version = "0.7", features = ["sqlite", "runtime-tokio-rustls"] }
clap = { version = "4.0", features = ["derive"] }
futures = "0.3"
EOF

# Copier Cargo.lock
COPY --chown=rustuser:rustuser Cargo.lock ./

# Copier les fichiers de config Cargo pour chaque crate
COPY --chown=rustuser:rustuser crypto-lib/Cargo.toml ./crypto-lib/
COPY --chown=rustuser:rustuser common/Cargo.toml ./common/
COPY --chown=rustuser:rustuser blockchain-server/Cargo.toml ./blockchain-server/
COPY --chown=rustuser:rustuser api-gateway/Cargo.toml ./api-gateway/
COPY --chown=rustuser:rustuser tests/Cargo.toml ./tests/

# Créer sources dummy pour cache des dépendances
RUN mkdir -p crypto-lib/src common/src blockchain-server/src api-gateway/src tests/src && \
    echo "pub fn lib() {}" > crypto-lib/src/lib.rs && \
    echo "pub fn lib() {}" > common/src/lib.rs && \
    echo "fn main() {}" > blockchain-server/src/main.rs && \
    echo "fn main() {}" > api-gateway/src/main.rs && \
    echo "pub fn lib() {}" > tests/src/lib.rs

# Précompiler les dépendances
RUN cargo build --release --bin blockchain-server

# Supprimer les sources dummy
RUN rm -rf crypto-lib/src common/src blockchain-server/src api-gateway/src tests/src

# Copier le code source réel
COPY --chown=rustuser:rustuser crypto-lib ./crypto-lib
COPY --chown=rustuser:rustuser common ./common
COPY --chown=rustuser:rustuser blockchain-server ./blockchain-server
COPY --chown=rustuser:rustuser api-gateway ./api-gateway
COPY --chown=rustuser:rustuser tests ./tests

# Compiler le projet final
RUN cargo build --release --bin blockchain-server

# Stage runtime
FROM debian:bookworm-slim AS runtime

# Installer dépendances runtime
RUN apt-get update && apt-get install -y \
    libssl3 \
    libsqlite3-0 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Créer utilisateur
RUN useradd -m -u 1000 rustuser
USER rustuser
WORKDIR /app

# Créer répertoires
RUN mkdir -p /app/data /app/logs

# Copier le binaire
COPY --from=builder --chown=rustuser:rustuser /app/target/release/blockchain-server /app/blockchain-server

# Exposer le port
EXPOSE 8080

# Variables d'environnement
ENV BLOCKCHAIN_BIND_ADDRESS=0.0.0.0
ENV BLOCKCHAIN_API_PORT=8080
ENV BLOCKCHAIN_DATABASE_URL=sqlite:./blockchain.db

# Commande de démarrage
CMD ["/app/blockchain-server"]