# Dockerfile pour le Mock Blockchain Server Python
FROM python:3.11-slim

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Créer répertoire de travail
WORKDIR /app

# Installer les dépendances Python
RUN pip install --no-cache-dir \
    flask==2.3.3 \
    flask-cors==4.0.0 \
    flask-socketio==5.3.4

# Copier le script du serveur
COPY mock-server.py /app/mock-server.py

# Créer utilisateur non-root
RUN useradd -r -u 1001 mockuser && \
    chown -R mockuser:mockuser /app

USER mockuser

# Exposer le port
EXPOSE 5000

# Variables d'environnement
ENV FLASK_APP=mock-server.py
ENV FLASK_ENV=production

# Commande de démarrage
CMD ["python", "mock-server.py"]