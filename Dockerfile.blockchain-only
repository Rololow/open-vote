# Dockerfile pour le serveur blockchain uniquement
FROM rustlang/rust:nightly-slim AS builder

# Installer les dépendances système nécessaires
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Créer un répertoire de travail
WORKDIR /app

# Copier seulement les fichiers nécessaires pour le blockchain
COPY crypto-lib/ ./crypto-lib/
COPY common/ ./common/
COPY blockchain-server/ ./blockchain-server/

# Créer un Cargo.toml minimal pour le workspace blockchain
RUN cat > Cargo.toml << 'EOF'
[workspace]
members = [
    "crypto-lib",
    "common", 
    "blockchain-server"
]
resolver = "2"

[workspace.dependencies]
tokio = { version = "1.35", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
uuid = { version = "1.6", features = ["v4", "serde"] }
chrono = { version = "0.4", features = ["serde"] }
sha2 = "0.10"
ed25519-dalek = "2.0"
rand = "0.8"
hex = "0.4"
thiserror = "1.0"
anyhow = "1.0"
axum = "0.7"
tower = "0.4"
tower-http = { version = "0.5", features = ["cors", "fs", "trace"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
sqlite = "0.32"
sqlx = { version = "0.7", features = ["runtime-tokio-rustls", "sqlite", "chrono", "uuid"] }

[workspace.package]
version = "0.1.0"
edition = "2021"
EOF

# Créer un Cargo.lock vide
RUN cargo generate-lockfile

# Compiler le projet blockchain
RUN cargo build --release --bin blockchain-server

# Stage final - runtime
FROM debian:bookworm-slim

# Installer les dépendances runtime
RUN apt-get update && apt-get install -y \
    libssl3 \
    libsqlite3-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Créer utilisateur non-root
RUN useradd -r -u 1001 blockchain

# Créer répertoires avec permissions appropriées
RUN mkdir -p /app/data /app/logs && \
    chown -R blockchain:blockchain /app

# Copier le binaire depuis le builder
COPY --from=builder --chown=blockchain:blockchain /app/target/release/blockchain-server /app/blockchain-server

# Changer vers l'utilisateur non-root
USER blockchain
WORKDIR /app

# Exposer le port
EXPOSE 8080

# Variables d'environnement par défaut
ENV BLOCKCHAIN_BIND_ADDRESS=0.0.0.0
ENV BLOCKCHAIN_API_PORT=8080
ENV BLOCKCHAIN_DATABASE_URL=sqlite:./data/blockchain.db
ENV RUST_LOG=info

# Commande de démarrage
CMD ["./blockchain-server"]